# 环境变量配置
# 复制为 .env 后填写真实值

# LLM 提供商: deepseek | openai | anthropic | mock
# mock 为离线演示模式：无需 API Key，用于验证流式输出/工具调用/审批链路
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 存储后端: memory | redis | postgres
MEMORY_BACKEND=memory

# 向量存储: local | pinecone | qdrant
VECTOR_BACKEND=local

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 环境: dev | staging | prod
APP_ENV=dev

# Web API 认证：非空时 /api/* 强制校验请求头 X-Api-Key 且绑定 0.0.0.0；
# 为空时仅绑定 127.0.0.1 本机访问。远程部署必须设置
WEB_API_KEY=

# Web 监听地址/端口（secpt web；命令行 --host/--port 优先于此处）
# 未设置 WEB_API_KEY 时地址强制为 127.0.0.1，此处配置不生效
HARNESS_HOST=
HARNESS_PORT=8000
