# secpt 环境变量示例——【环境变量是唯一配置源】（config.yaml 已移除）（.env 已被 gitignore，切勿提交）
# 加载规则：项目根 .env 自动加载；已 export 的同名变量优先（.env 不覆盖真实环境）
# 也可用 SECPT_ENV_FILE=/path/to/other.env 指定其他文件

# ───────── 模型（唯一必填项）─────────
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 任意 OpenAI 兼容端点 / 自建网关（模型名 provider/model 形式使用）：
#SECPT_MODEL_BASE_OPENAI=https://api.openai.com/v1
#SECPT_MODEL_KEY_OPENAI=sk-xxx
#SECPT_MODEL_BASE_MYGW=https://gw.internal/v1
#SECPT_MODEL_KEY_MYGW=xxx


# 主模型 / 回退模型（不配则 deepseek-chat / deepseek-reasoner）：
#SECPT_MODEL_PRIMARY=deepseek-chat
#SECPT_MODEL_FALLBACK=deepseek-reasoner

# 多 provider 故障转移链（熔断 3 次/60s；链成员仍走上面的端点解析）：
#SECPT_MODEL_POOL=deepseek-chat,openai/gpt-4o

# 网关模型上下文比默认大时（如 128k 网关）减少压缩次数：
#SECPT_CONTEXT_WINDOW=128000

# ───────── 请求参数（不配则用服务端默认；超时默认 180s）─────────
#SECPT_LLM_TEMPERATURE=0.2
#SECPT_LLM_MAX_TOKENS=4096
#SECPT_LLM_TIMEOUT_S=180

# ───────── 成本单价（CNY/1K token，预算记账用）─────────
#SECPT_PRICING_INPUT_PER_1K=0.002
#SECPT_PRICING_OUTPUT_PER_1K=0.008

#SECPT_FAKE_LLM=1               # FakeLLM 干跑（无 key 全链路演练）
# ───────── 执行沙箱（Docker）─────────
#SECPT_SANDBOX=0                # 全局关闭沙箱（等价 solve --no-sandbox）
#SECPT_SANDBOX_MODE=docker      # auto|docker|none
#SECPT_SANDBOX_IMAGE=secpt-sandbox
#SECPT_SANDBOX_NETWORK=bridge   # 内网靶场可设 host

# ───────── 人在环路 ─────────
#SECPT_INTERCEPT=0              # 全局关闭命令拦截审批
#SECPT_INTERCEPT_DEFAULT=allow  # 未命中规则的默认动作：allow|ask（ask=全部人工把关）

# ───────── 运行 ─────────
#SECPT_VAR=var                  # 数据根（jobs/findings/图记忆等运行时数据）
#SECPT_EXPERIENCE=0             # 关闭历史经验注入

# ───────── 子智能体（delegate 工具，市场标准形态：一次委托/独立上下文/禁递归）─────────
#SECPT_DELEGATE=1               # 开启 delegate 工具（默认关；子链由父链按需派生）
#SECPT_DELEGATE_STEPS=25        # 子链步数预算（5-60）
#SECPT_DELEGATE_WALL=600        # 子链墙钟上限（秒，最小 60）

# ───────── 联网检索（web_search 插件，三选一）─────────
#TAVILY_API_KEY=xxx             # Tavily Search API
#BRAVE_API_KEY=xxx              # Brave Search API
#SECPT_SEARCH_URL=https://searx.example   # 自建 SearXNG（settings.yml 需开 json 格式）

# ───────── Benchmark 并发防护 ─────────
#BENCHMARK_TASK_ID=task_xxx     # 账本按任务隔离（每开新任务更新）
#SECPT_BENCHMARK_FORCE=1        # 强制允许双开跑分（默认拒绝：并发会争抢平台容器上限）

# ───────── VPN 自举（benchmark 内网任务）─────────
#SECPT_VPN_TYPE=openvpn          # openvpn | wireguard | none（none=不托管，假定已连）
#SECPT_VPN_CONFIG=/path/to/client.ovpn   # ovpn 或 wg 配置文件
#SECPT_VPN_PROBE_URL=http://10.0.100.58  # 连通探针（up 后自动验证）
#SECPT_VPN_SUDO=1                # openvpn/wg-quick 需要 root（sudo -n）
# 用法：secpt vpn up / status / down；或 secpt solve <任务.md> --vpn（自动拉起+沙箱切 host 网络）

# ───────── Benchmark 评测凭证 ─────────
#BENCHMARK_TOKEN=xxx
#BENCHMARK_BASE_URL=http://benchmark.example.com

# ───────── 三档止损状态机（docs/设计-工作循环形态.md §2；=0 回退旧行为）─────────
#SECPT_LOOP_STOP=1              # 总开关：0=只留 nudge+硬预算墙（回退）
#SECPT_WRAP_AFTER_NUDGE=8       # nudge 后无改善多少步进入收尾档（注入收尾指令）
#SECPT_WRAP_AT_PCT=90           # 步数/预算达该百分比直接进入收尾档
#SECPT_STALL_AFTER_WRAP=8       # 收尾档多少步未产 ANSWER → 判 stalled 交编排层
#SECPT_MARGIN_WINDOW=20         # 边际收益滚动窗口（步）
#SECPT_MARGIN_COST_CNY=0.05     # 窗口零成果成本阈值（元；无 budget tracker 不生效）

# ───────── 编排层增强（同设计文档 §3/§4）─────────
#SECPT_VERIFY_MODEL=            # verify 意图的异构模型（缺省=主模型；建议跨厂商）
#SECPT_GOAL_REVISION=ask        # 目标演化提案：ask=人工审批（默认）/auto=纯细化自动/off=关
# RESET（stalled 换会话重建）与 retro() 失败递归为确定性编排行为，无需配置；
# 递归受意图总数上限（max_intents）约束，每父意图最多展开一层。
