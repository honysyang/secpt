# secpt 环境变量示例——【环境变量是唯一配置源】（config.yaml 已移除）（.env 已被 gitignore，切勿提交）
# 加载规则：项目根 .env 自动加载；已 export 的同名变量优先（.env 不覆盖真实环境）
# 也可用 SECPT_ENV_FILE=/path/to/other.env 指定其他文件

# ───────── 镜像部署（secpt-agent：执行时 env 注入，凭证绝不进镜像）─────────
# 构建：scripts/build-agent-image.sh（.dockerignore 已把 .env/vpn/凭证挡在构建上下文外）
# 运行（--env-file 注入的值即真实环境变量，优先级最高）：
#   docker run --rm --env-file prod.env \
#     --cap-add NET_ADMIN --device /dev/net/tun \   # 仅内网 VPN 场景需要
#     secpt-agent:latest
# 容器内注意：
#   - 项目根 .env 不会被读取（包安装路径下无项目根）——一律用 --env-file / -e 注入
#   - HTTP(S)_PROXY 会被 LLM 客户端/urllib/curl 自动识别（受限网络出网用）
#   - entrypoint 附加参数：SECPT_ENTRY_RETRIES=2 SECPT_ENTRY_RETRY_SLEEP=15
#     SECPT_CHALLENGE_DIR=/app/challenges/tsec-benchmark SECPT_SOLVE_ARGS="--vpn"
# 必填：DEEPSEEK_API_KEY（或 SECPT_MODEL_API_KEY 等任意 provider 形态）+ BENCHMARK_TOKEN
# 常用：BENCHMARK_BASE_URL / BENCHMARK_TASK_ID / SECPT_MODEL_BASE_URL / SECPT_MODEL_NAME
# VPN（内网场景）：SECPT_VPN_TYPE=openvpn + SECPT_VPN_CONFIG=容器内路径 + SECPT_VPN_PROBE_URL
# 调优：SECPT_BENCHMARK_WORKERS / SECPT_CAMPAIGN_ROUNDS / SECPT_WAIT_S /
#       SECPT_MENTOR(+SECPT_MENTOR_MODEL) / SECPT_MAX_TOOL_CALLS / SECPT_TOOL_POOL

# ───────── 模型（唯一必填项）─────────
DEEPSEEK_API_KEY=sk-xxxxxxxx

# .env 语法：支持 export KEY=VALUE 前缀、行内注释（KEY=value # 注释，# 前须有空白）、
# 成对引号；真实 export 的同名变量优先于 .env 文件。

# base URL 惯例变量（.env 里最常见的业界写法，直接识别，无需 secpt 专有前缀）：
#DEEPSEEK_BASE_URL=https://api.deepseek.com      # deepseek provider 的 base URL 兜底
#OPENAI_BASE_URL=https://api.openai.com/v1       # openai provider 的 base URL 兜底
# 优先级：SECPT_MODEL_BASE_URL > SECPT_MODEL_BASE_<PREFIX> > 惯例变量 > provider 内置默认

# 通用自定义端点（任意 OpenAI 兼容网关：vLLM / one-api / 内网代理等）
# 三项独立覆盖；未设置的项按 provider 规则解析。
# 例：SECPT_MODEL_BASE_URL=https://gw.internal/v1
#     SECPT_MODEL_NAME=qwen3-32b
#     SECPT_MODEL_API_KEY=sk-xxx
# 注意：SECPT_MODEL_NAME 会覆盖主模型/回退模型/角色模型的 model id；
#       base URL 需含网关要求的版本前缀（如 /v1）。
#SECPT_MODEL_BASE_URL=
#SECPT_MODEL_NAME=
#SECPT_MODEL_API_KEY=
# 可选：非标准鉴权/路径（Azure 等）
#SECPT_MODEL_AUTH_HEADER=Authorization   # 如 api-key
#SECPT_MODEL_AUTH_SCHEME=Bearer          # 置空=直接用 key 值
#SECPT_MODEL_CHAT_PATH=/chat/completions # base 已含该路径时不会重复拼接
#SECPT_MODEL_EXTRA_HEADERS={"X-Tenant":"t1"}  # 额外请求头（JSON 对象）

# 任意 OpenAI 兼容端点 / 自建网关（模型名 provider/model 形式使用）：
#SECPT_MODEL_BASE_OPENAI=https://api.openai.com/v1
#SECPT_MODEL_KEY_OPENAI=sk-xxx
# GLM（智谱，路由已内置）：模型名写 glm/<model> 即走 bigmodel 端点
#ZHIPU_API_KEY=你的GLMkey                          # 或 SECPT_MODEL_KEY_GLM=xxx
#SECPT_MODEL_BASE_GLM=https://open.bigmodel.cn/api/paas/v4   # 官方标准端点默认
#   Coding Plan 套餐须换专用端点（key 不通用）：
#   SECPT_MODEL_BASE_GLM=https://open.bigmodel.cn/api/coding/paas/v4
#SECPT_MODEL_BASE_MYGW=https://gw.internal/v1
#SECPT_MODEL_KEY_MYGW=xxx
#SECPT_MODEL_KEYENV_MYGW=MYGW_KEY   # 间接指定 key 的环境变量名


# 主模型 / 回退模型（不配则 deepseek-chat / deepseek-reasoner）：
#SECPT_MODEL_PRIMARY=deepseek-chat
#SECPT_MODEL_FALLBACK=deepseek-reasoner

# 多 provider 故障转移链（熔断 3 次/60s；链成员仍走上面的端点解析）：
#SECPT_MODEL_POOL=deepseek-chat,openai/gpt-4o

# 网关模型上下文比默认大时（如 128k 网关）减少压缩次数：
#SECPT_CONTEXT_WINDOW=128000

# ───────── 请求参数（不配则用服务端默认；超时默认 180s）─────────
#SECPT_LLM_TEMPERATURE=0.2
#SECPT_LLM_MAX_TOKENS=4096
#SECPT_LLM_TIMEOUT_S=180

# ───────── 成本单价（CNY/1K token，预算记账用）─────────
#SECPT_PRICING_INPUT_PER_1K=0.002
#SECPT_PRICING_OUTPUT_PER_1K=0.008

#SECPT_FAKE_LLM=1               # FakeLLM 干跑（无 key 全链路演练）
# ───────── 执行沙箱（Docker）─────────
#SECPT_SANDBOX=0                # 全局关闭沙箱（等价 solve --no-sandbox）
#SECPT_SANDBOX_MODE=docker      # auto|docker|none
#SECPT_SANDBOX_IMAGE=secpt-sandbox
#SECPT_SANDBOX_NETWORK=bridge   # 内网靶场可设 host

# ───────── 人在环路 ─────────
#SECPT_INTERCEPT=0              # 全局关闭命令拦截审批
#SECPT_INTERCEPT_DEFAULT=allow  # 未命中规则的默认动作：allow|ask（ask=全部人工把关）

# ───────── 运行 ─────────
#SECPT_VAR=var                  # 数据根（jobs/findings/图记忆等运行时数据）
#SECPT_EXPERIENCE=0             # 关闭历史经验注入

# ───────── 子智能体（delegate 工具，市场标准形态：一次委托/独立上下文/禁递归）─────────
#SECPT_DELEGATE=1               # 开启 delegate 工具（默认关；子链由父链按需派生）
#SECPT_DELEGATE_STEPS=25        # 子链步数预算（5-60）
#SECPT_DELEGATE_WALL=600        # 子链墙钟上限（秒，最小 60）

# ───────── 编排 v3（独立任务 / 后勤 / 交付门 / 教练）─────────
#SECPT_ORCH_LOGISTICS=0         # 关闭后勤后台通道（默认开；执行体可用 delegate_logistics 异步委托）
#SECPT_ORCH_DELIVERY=0          # 关闭交付门（默认开；主路径排空后核验/复验并判定是否结束）
#SECPT_ORCH_JEV=1               # 让外部 typed JEV 参与 main/logistics 快判（需 JEV_API_KEY）
#SECPT_ORCH_COMMANDER=0         # 关闭 v4 Commander（默认开：假设树+战略文档+值守层唤醒；回退 v3 planner）
#SECPT_LOGISTICS_WORKERS=2      # 后勤后台并发（1-4；默认 2：下载与批量搜索可并行）
#SECPT_ROLE_TEMPLATES=1         # legacy：恢复 recon/exploit/lateral/verify/report 角色模板与 role_stage
#SECPT_MENTOR=1                 # 可选：卡死决策点用强模型导师诊断换路线（默认关，失败回退固定文案）
#SECPT_MENTOR_MODEL=xxx         # 导师模型（缺省 SECPT_ESCALATE_MODEL）


# ───────── 联网检索（web_search 插件，三选一）─────────
#TAVILY_API_KEY=xxx             # Tavily Search API
#BRAVE_API_KEY=xxx              # Brave Search API
#SECPT_SEARCH_URL=https://searx.example   # 自建 SearXNG（settings.yml 需开 json 格式）

# ───────── Benchmark 并发防护 ─────────
#BENCHMARK_TASK_ID=task_xxx     # 账本按任务隔离（每开新任务更新）
#SECPT_BENCHMARK_FORCE=1        # 强制允许双开跑分（默认拒绝：并发会争抢平台容器上限）

# ───────── VPN 自举（benchmark 内网任务）─────────
#SECPT_VPN_TYPE=openvpn          # openvpn | wireguard | none（none=不托管，假定已连）
#SECPT_VPN_CONFIG=/path/to/client.ovpn   # ovpn 或 wg 配置文件
#SECPT_VPN_PROBE_URL=http://10.0.100.58  # 连通探针（up 后自动验证）
#SECPT_VPN_SUDO=1                # openvpn/wg-quick 需要 root（sudo -n）
# 用法：secpt vpn up / status / down；或 secpt solve <任务.md> --vpn（自动拉起+沙箱切 host 网络）

# ───────── Benchmark 评测凭证 ─────────
#BENCHMARK_TOKEN=xxx
#BENCHMARK_BASE_URL=http://benchmark.example.com

# ───────── 三档止损状态机（docs/设计-工作循环形态.md §2；=0 回退旧行为）─────────
#SECPT_LOOP_STOP=1              # 总开关：0=只留 nudge+硬预算墙（回退）
#SECPT_WRAP_AFTER_NUDGE=8       # nudge 后无改善多少步进入收尾档（注入收尾指令）
#SECPT_WRAP_AT_PCT=90           # 步数/预算达该百分比直接进入收尾档
#SECPT_STALL_AFTER_WRAP=8       # 收尾档多少步未产 ANSWER → 判 stalled 交编排层
#SECPT_MARGIN_WINDOW=20         # 边际收益滚动窗口（步）
#SECPT_MARGIN_COST_CNY=0.05     # 窗口零成果成本阈值（元；无 budget tracker 不生效）

# ───────── 编排层增强（同设计文档 §3/§4）─────────
#SECPT_VERIFY_MODEL=            # verify 意图的异构模型（缺省=主模型；建议跨厂商）
#SECPT_GOAL_REVISION=ask        # 目标演化提案：ask=人工审批（默认）/auto=纯细化自动/off=关
# RESET（stalled 换会话重建）与 retro() 失败递归为确定性编排行为，无需配置；
# 递归受意图总数上限（max_intents）约束，每父意图最多展开一层。

# ───────── 评判层（Jev 门控 / judge / 反作弊）─────────
#JEV_API_KEY=                    # TypeSafe System One key；未设置自动降级纯 LLM judge
#JEV_BASE_URL=https://api.typesafe.ai
#JEV_MIN_CONFIDENCE=0.85        # 高置信采信阈值，低置信升级到 LLM judge
#SECPT_JEV_CACHE=1               # memo 缓存：同输入重复判定命中磁盘缓存（var/jev-decisions.json）
#SECPT_JUDGE_MODEL=              # 终裁 judge 独立模型（覆盖 --model；建议跨厂商，防自评自裁）
#SECPT_DIRECT_RESET=1            # 单链/direct 路径 stalled → RESET 换会话重建（=0 关闭）

# ───────── 交战规则（ROE 双模治理）─────────
# profile.roe 段：mode=ctf（默认，竞技/实验）| authorized（授权实战：solve 打印
# ROE 横幅 + 引擎步间节速）；throttle_ms 为每 step sleep 毫秒数（防突发压力、操作留痕）
#SECPT_ROE_THROTTLE_MS=          # env 覆盖 profile.roe.throttle_ms（authorized 调参用）

# ───────── 跑分战役（A2/A3，2026-10-17）─────────
#SECPT_CAMPAIGN_ROUNDS=3        # 自动轮数：每轮按平台实况重试未完成题（digest 已注入）
#SECPT_CAMPAIGN_WALL_S=0        # 战役总墙钟上限（0=不限，由平台任务时限控制）
#SECPT_BENCHMARK_WORKERS=3      # 并发 worker（平台容器上限 3；想留 1 槽设 2）
#SECPT_WAIT_S=40                # api.py wait 端口就绪等待上限（自适应 2s 轮询）
#SECPT_WRAP_MIN_STEPS=          # nudge→wrap 最低步数地板（缺省=max(20, 35%*max_steps)）

# ───────── 通用长任务能力（M0/M1/M3，2026-10-17；非跑分专属）─────────
#SECPT_ESCALATE_MODEL=          # 意图重试（attempts>1）升级模型（0day/硬目标用强模型）
#SECPT_INTENT_WALL_S=           # 通用意图墙钟上限（frontier 调用方按需设置）
#SECPT_DEADLINE_TS=             # 全局截止（epoch 秒）：到点前 reserve 内停止认领新意图
#SECPT_BENCH_STEP_WALL_S=10     # 跑分意图墙钟 = 步数 × 该值（0=关闭安全网）

# ───────── M4 工具面（通用，2026-10-17）─────────
#SECPT_OOB_BIND=0.0.0.0        # OOB 回调监听地址（目标可达即可；默认所有接口）
#SECPT_OOB_HOST=               # 投递给目标的回调 IP（缺省自动取 tun*/wg* 地址）
#SECPT_OOB_PORT=0              # 回调端口（0=自动分配）
#SECPT_BENCH_BROWSER=0         # 跑分 web 题按需启用 browser_*（需 playwright；默认关）
#SECPT_TECHNIQUES=1            # 通用打法模板注入（SSRF/SSTI/反序列化等；=0 关闭）
#SECPT_TOOL_POOL=1             # 备选工具池：agent 用 request_tools 运行时启用
#                              # http_request/session/recon_parse/oob/analyze_binary/
#                              # crypto_pubkey/pwn_checksec（benchmark 战役默认开）
#SECPT_AUTO_STRUCTURE=1        # bash 扫描输出（nmap/ffuf/gobuster…）自动结构化入
#                              # ws/assets.json（喂图记忆；=0 关闭）
#SECPT_MAX_TOOL_CALLS=         # 意图级工具调用硬上限（超限强制收尾）；未设=按角色
#                              # 分档（exploit/recon/lateral=100，verify/report=20，
#                              # 无角色不限）；0/off=全局关闭
#SECPT_MENTOR=1                # 导师止损：卡死 nudge 时先调强模型诊断+换路线建议
#                              # （PentAGI Mentor 思想；默认关；模型未配/调用失败
#                              # 自动回退固定文案）
#SECPT_MENTOR_MODEL=           # 导师模型（缺省取 SECPT_ESCALATE_MODEL；建议跨厂商/强档）
#SECPT_MENTOR_MAX_CALLS=2      # 每意图导师调用配额（成本护栏）
