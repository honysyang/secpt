# secpt 环境变量模板：复制为 .env 后填真实值（.env 已被 .gitignore 忽略）
#
# 用法（二选一）：
#   A. 当前 shell 生效：      set -a; . ./.env; set +a
#   B. 让 secpt 自己装载：    SECPT_ENV_FILE=.env secpt run --goal "..."
# 规则：真实环境变量永远优先于本文件；只接受 SECPT_* 与 LLM_PROVIDER 两类键。

# ---- 模型（必填）------------------------------------------------------------
# mock = 离线脚本演示；openai = 任何 OpenAI 兼容服务
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# SECPT_LLM_BASE_URL=https://api.deepseek.com/v1
# SECPT_LLM_API_KEY=sk-你的key
# SECPT_LLM_MODEL=deepseek-chat

# ---- 运行产物（可选，默认落在当前目录）--------------------------------------
# SECPT_DB=./secpt.db
# SECPT_RAW_DIR=./raw
# SECPT_PROFILE=configs/profile.toml
# SECPT_ENV=lab

# ---- 工具与并发（可选）------------------------------------------------------
# SECPT_NMAP_BIN=/usr/bin/nmap
# SECPT_WORKERS=3

# ---- 资产覆盖（可选）--------------------------------------------------------
# SECPT_ASSETS_DIR=/path/to/assets
