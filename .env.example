# secpt 环境变量示例（pydantic-settings 会优先读取，再回退到 config.yaml）
# 复制为 .env 并填入真实值；切勿提交 .env

# ───────── LLM（DeepSeek via litellm）─────────
# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=
# 可选：自定义 base_url（如使用自建网关或代理）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 覆盖 config.yaml 的 llm 字段（嵌套用 __）
#SECPT_LLM__PROVIDER=deepseek
#SECPT_LLM__PLANNING_MODEL=deepseek-chat
#SECPT_LLM__EVAL_MODEL=deepseek-v1-flash
#SECPT_LLM__API_KEY_ENV=DEEPSEEK_API_KEY
#SECPT_LLM__TEMPERATURE=0.2
#SECPT_LLM__MAX_TOKENS=2048
#SECPT_LLM__TIMEOUT_S=60.0
#SECPT_LLM__FAKE=false

# ───────── GraphStore ─────────
#SECPT_GRAPH__BACKEND=sqlite
#SECPT_GRAPH__SQLITE_PATH=./data/graphstore.sqlite
#SECPT_GRAPH__POSTGRES_DSN=postgresql+asyncpg://user:pass@localhost:5432/secpt

# ───────── Logging ─────────
#SECPT_LOG__LEVEL=INFO
#SECPT_LOG__JSON=false

# ───────── Runtime ─────────
#SECPT_REACT__MAX_STEPS=12
#SECPT_REACT__TIMEOUT_S=600
#SECPT_TOOLS__WHITELIST=nmap,curl,httpx,dig,whois,nuclei
